{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0.0",
  "name": "orchy-config",
  "description": "Orchy: Supervisor/subagent roles, activation, runtime adapter selection, dispatch policy, tracking, activity log",
  "supervisor": {
    "role": "Supervisor & Architect",
    "capabilityRequirement": "high_reasoning_and_planning",
    "model": "pro",
    "responsibilities": [
      "Task intake and decomposition",
      "Dependency ordering and interface freezes",
      "Interactive human-in-the-loop decisions",
      "Subagent dispatch and parallel scheduling",
      "Context window pruning and memory management",
      "Independent re-verification of subagent claims",
      "Sole writer for ticket board, git commits, and gh operations"
    ]
  },
  "roles": {
    "scout": {
      "name": "Codebase Scout / Explorer",
      "capabilityRequirement": "fast_read_and_symbol_retrieval",
      "model": "flash_lite",
      "description": "Reads files, greps patterns, locates symbols, and surveys project structure",
      "readOnly": true,
      "maxContextTargetTokens": 20000
    },
    "implementer": {
      "name": "Feature Implementer / Coder",
      "capabilityRequirement": "precise_code_synthesis",
      "model": "flash",
      "description": "Performs scoped code modifications, adds new features, or refactors within isolated files",
      "readOnly": false,
      "maxContextTargetTokens": 40000
    },
    "tester": {
      "enabled": false,
      "name": "Log Interpreter (optional)",
      "capabilityRequirement": "cli_execution_and_log_parsing",
      "model": "flash_lite",
      "description": "Runs a command and summarizes a long log. Never the recorded verification: the Supervisor re-runs the command itself with output redirected",
      "readOnly": true,
      "canExecute": true,
      "maxContextTargetTokens": 20000
    },
    "reviewer": {
      "name": "Code Standards & Spec Reviewer",
      "capabilityRequirement": "spec_critique_and_smell_detection",
      "model": "flash",
      "description": "Performs static code review, detects code smells, and ensures architectural consistency",
      "readOnly": true,
      "maxContextTargetTokens": 30000
    }
  },
  "activation": {
    "defaultMode": "opt_in",
    "triggerPrefix": "orchy:",
    "commandPattern": "^orchy (on|off|init|update|status|cancel)$",
    "workspaceContinuousEnabled": false,
    "notifyOnActivation": true,
    "requireInitBeforeOrchestration": true,
    "complexityThreshold": {
      "minFiles": 3,
      "minModules": 2,
      "minExpectedReads": 10,
      "minParallelUnits": 2,
      "contextOnlyMultiplier": 2
    }
  },
  "runtime": {
    "_comment": "name is a row in references/runtime-adapters.md; overrides are null (use table) / true / false. Mode is re-derived every session; lastDerivedMode is display-only.",
    "name": "unknown",
    "overrides": {
      "spawnSubagent": null,
      "perSubagentModelSelection": null,
      "liveMessaging": null,
      "terminateSubagent": null,
      "parallelDispatch": null
    },
    "lastDerivedMode": null,
    "lastDerivedAt": null
  },
  "dispatchPolicy": {
    "allowParallel": true,
    "maxConcurrentSubagents": 4,
    "isolation": "shared-tree",
    "worktreeRoot": ".orchy/wt",
    "scopeCheck": {
      "enabled": true,
      "script": "scripts/orchy-scope-check.sh",
      "protectedPaths": [".agents/TICKETS.md", ".agents/orchy-metrics.jsonl"],
      "onViolation": "revert_and_fail"
    },
    "verification": {
      "runBySupervisor": true,
      "logDir": ".orchy",
      "tailLines": 20
    },
    "enforceDisjointFiles": true,
    "enforceDependencyOrder": true,
    "sharedHotspotFiles": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "pyproject.toml",
      "requirements.txt",
      "Cargo.toml",
      "Cargo.lock",
      "go.mod",
      "go.sum",
      "**/index.ts",
      "**/index.js",
      "**/__init__.py",
      ".agents/TICKETS.md"
    ],
    "checkpointBeforeDispatch": true,
    "revertWaveOnPartialFailure": true,
    "handoverResultIsData": true,
    "knownFactsRequireCitations": true,
    "feedbackLoopMaxRetries": 2,
    "feedbackLoopMaxRetriesWithoutLiveMessaging": 1
  },
  "ticketing": {
    "provider": "markdown",
    "markdownPath": ".agents/TICKETS.md",
    "github": {
      "syncWithIssues": true,
      "issueLabelPrefix": "orchy:"
    },
    "writer": "supervisor",
    "allowSubagentTicketing": false,
    "subagentsMayCommit": false
  },
  "metrics": {
    "enabled": true,
    "kind": "activity_log",
    "ledgerPath": ".agents/orchy-metrics.jsonl",
    "writer": "supervisor",
    "recordSoloBaseline": false,
    "usage": "runtime_reported_only",
    "gitignore": [".orchy/", ".agents/orchy-metrics.jsonl"],
    "pricing": {
      "_comment": "USD per 1M tokens, keyed by model name. Used by `orchy status` only over entries with runtime-reported usage. Leave null to report counts only.",
      "pro": { "input": null, "output": null },
      "flash": { "input": null, "output": null },
      "flash_lite": { "input": null, "output": null }
    }
  }
}
