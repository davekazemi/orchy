{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.2.0",
  "name": "orchy-config",
  "description": "Cost-optimized agent orchestration matrix and subagent dispatch parameters",
  "supervisor": {
    "role": "Supervisor & Architect",
    "capabilityRequirement": "high_reasoning_and_planning",
    "model": "pro",
    "responsibilities": [
      "Task intake and decomposition",
      "Dependency ordering and interface freezes",
      "Interactive human-in-the-loop decisions",
      "Subagent dispatch and parallel scheduling",
      "Context window pruning and memory management",
      "Independent re-verification of subagent claims",
      "Sole writer for ticket board, git commits, and gh operations"
    ]
  },
  "roles": {
    "scout": {
      "name": "Codebase Scout / Explorer",
      "capabilityRequirement": "fast_read_and_symbol_retrieval",
      "model": "flash_lite",
      "description": "Reads files, greps patterns, locates symbols, and surveys project structure",
      "readOnly": true,
      "maxContextTargetTokens": 20000
    },
    "implementer": {
      "name": "Feature Implementer / Coder",
      "capabilityRequirement": "precise_code_synthesis",
      "model": "flash",
      "description": "Performs scoped code modifications, adds new features, or refactors within isolated files",
      "readOnly": false,
      "maxContextTargetTokens": 40000
    },
    "tester": {
      "name": "Test & Verification Engineer",
      "capabilityRequirement": "cli_execution_and_log_parsing",
      "model": "flash_lite",
      "description": "Executes unit tests, linting, build pipelines, and reports failure logs concisely",
      "readOnly": true,
      "canExecute": true,
      "maxContextTargetTokens": 20000
    },
    "reviewer": {
      "name": "Code Standards & Spec Reviewer",
      "capabilityRequirement": "spec_critique_and_smell_detection",
      "model": "flash",
      "description": "Performs static code review, detects code smells, and ensures architectural consistency",
      "readOnly": true,
      "maxContextTargetTokens": 30000
    }
  },
  "activation": {
    "defaultMode": "opt_in",
    "triggerPrefix": "orchy:",
    "workspaceContinuousEnabled": false,
    "notifyOnActivation": true,
    "requireInitBeforeOrchestration": true,
    "complexityThreshold": {
      "minFiles": 3,
      "minModules": 2,
      "minExpectedReads": 10,
      "minParallelUnits": 2,
      "contextOnlyMultiplier": 2
    }
  },
  "runtime": {
    "detectedMode": "auto",
    "capabilities": {
      "spawnSubagent": "auto",
      "perSubagentModelSelection": "auto",
      "liveMessaging": "auto",
      "terminateSubagent": "auto",
      "parallelDispatch": "auto"
    }
  },
  "dispatchPolicy": {
    "allowParallel": true,
    "maxConcurrentSubagents": 4,
    "enforceDisjointFiles": true,
    "enforceDependencyOrder": true,
    "sharedHotspotFiles": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "pyproject.toml",
      "requirements.txt",
      "Cargo.toml",
      "Cargo.lock",
      "go.mod",
      "go.sum",
      "**/index.ts",
      "**/index.js",
      "**/__init__.py",
      ".agents/TICKETS.md"
    ],
    "checkpointBeforeDispatch": true,
    "revertWaveOnPartialFailure": true,
    "compressSubagentReturns": true,
    "rawVerificationTailLines": 20,
    "supervisorReverifiesBeforeClose": true,
    "feedbackLoopMaxRetries": 2,
    "feedbackLoopMaxRetriesWithoutLiveMessaging": 1
  },
  "ticketing": {
    "provider": "markdown",
    "markdownPath": ".agents/TICKETS.md",
    "github": {
      "syncWithIssues": true,
      "issueLabelPrefix": "orchy:"
    },
    "writer": "supervisor",
    "allowSubagentTicketing": false,
    "subagentsMayCommit": false
  },
  "metrics": {
    "enabled": true,
    "ledgerPath": ".agents/orchy-metrics.jsonl",
    "writer": "supervisor",
    "recordSoloBaseline": false,
    "estimateWhenRuntimeHasNoUsageApi": true,
    "charsPerTokenEstimate": 4,
    "pricing": {
      "_comment": "USD per 1M tokens, keyed by the model names used in supervisor/roles. Leave empty to report raw tokens only.",
      "pro": { "input": null, "output": null },
      "flash": { "input": null, "output": null },
      "flash_lite": { "input": null, "output": null }
    }
  }
}
